{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Support Desk",
    "derivedFrom": [
      "usedesk.ru", "omnidesk.ru", "chat2desk.com", "jivo.ru", "naumen.ru",
      "intercom.com", "helpscout.com", "front.com", "gorgias.com", "tidio.com",
      "crisp.chat"
    ],
    "unavailable": ["zendesk.com", "freshworks.com", "liveagent.com", "zoho.com/desk", "kayako.com"],
    "note": "Значения сняты из CSS и HTML реальных сайтов, затем сведены по частоте."
  },
  "color": {
    "primary": "#0b5cff",
    "primaryHover": "#0043c7",
    "primaryActive": "#0038a8",
    "primarySoft": "#e8f0ff",
    "accent": "#ff6b2c",
    "accentHover": "#e85a1c",
    "accentSoft": "#fff0e8",
    "bg": "#f5f7fa",
    "surface": "#ffffff",
    "surfaceAlt": "#eff2f6",
    "border": "#dce1e8",
    "borderStrong": "#c3cbd8",
    "text": "#0f1e35",
    "textMuted": "#5d6b98",
    "textSubtle": "#8a9499",
    "success": "#12b76a",
    "warning": "#f79009",
    "danger": "#e5484d",
    "info": "#1972f5"
  },
  "font": {
    "sans": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, system-ui, sans-serif",
    "mono": "JetBrains Mono, Consolas, Courier New, monospace",
    "size": {
      "xs": "12px",
      "sm": "13px",
      "base": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px"
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "pill": "999px"
  },
  "shadow": {
    "xs": "0 1px 2px rgba(15,30,53,.06)",
    "sm": "0 2px 6px rgba(15,30,53,.07)",
    "md": "0 6px 18px rgba(15,30,53,.10)",
    "lg": "0 16px 40px rgba(15,30,53,.14)"
  },
  "control": {
    "height": "36px",
    "heightSm": "28px",
    "rowHeight": "44px"
  }
}
